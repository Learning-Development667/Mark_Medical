rules_version = '2';

// Care Log: accounts are data, not code. users/{uid} holds { name, role, relation }.
// role is "family" (full read and write), "readonly" (sees everything a family member
// sees, writes nothing) or "viewer" (a narrow read-only slice, see below); relation is
// "patient", "carer" or "". Records are created in the Firebase console (Authentication
// > Users gives the uid; Firestore Database > users > Add document), never by the app,
// so no email address appears in this file, in config.js or anywhere on the site.
// Publish this file in the Firebase console (Firestore Database > Rules) after any
// change here; editing this file alone does not reach the live database.
service cloud.firestore {
  match /databases/{database}/documents {

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && account().role in roles;
    }

    function isFamily() { return hasRole(['family']); }

    // Full read-only access: sees everything a family member sees (every entry type,
    // documents, cheers, exercise, meals, profile), never write access anywhere.
    function isReadOnly() { return hasRole(['readonly']); }

    // Narrow read-only viewer: medicines, med-log/vitals/trend entries and the chemo/mood
    // day records only. Never documents, cheers, food, notes, exercise or who-to-call,
    // and never write access.
    function isViewer() { return hasRole(['viewer']); }

    // Each document page is kept well under the 1 MiB Firestore limit by the app;
    // this guard stops anything oversized being written by mistake.
    function pageSizeOk() {
      return request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }

    // A signed-in person can read their own account record and nothing else here.
    // Nobody can create or change one from the app.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /entries/{entryId} {
      allow read: if isFamily() || isReadOnly() || (isViewer() && resource.data.type in ['med', 'temp', 'vitals', 'weight', 'sleep', 'drink']);
      allow write: if isFamily();
    }

    match /medicines/{medId} {
      allow read: if isFamily() || isReadOnly() || isViewer();
      allow write: if isFamily();
    }

    match /documents/{docId} {
      allow read: if isFamily() || isReadOnly();
      allow write: if isFamily();

      match /pages/{pageNo} {
        allow read: if isFamily() || isReadOnly();
        allow delete: if isFamily();
        allow create, update: if isFamily() && pageSizeOk();
      }
    }

    match /profile/{profileId} {
      allow read: if isFamily() || isReadOnly();
      allow write: if isFamily();
    }

    // Chemo plan: one document per calendar day (chemo session, done, mood, one good thing)
    match /days/{dayId} {
      allow read: if isFamily() || isReadOnly() || isViewer();
      allow write: if isFamily();
    }

    // Cheer board: short notes between the two of them
    match /cheers/{cheerId} {
      allow read: if isFamily() || isReadOnly();
      allow write: if isFamily();
    }

    // Exercise: one document per day (steps, which daily goals were done)
    match /exercise/{dayId} {
      allow read: if isFamily() || isReadOnly();
      allow write: if isFamily();
    }

    // Saved meals: quick buttons for logging food, with what goes with each one
    match /meals/{mealId} {
      allow read: if isFamily() || isReadOnly();
      allow write: if isFamily();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
