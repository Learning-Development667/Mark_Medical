rules_version = '2';

// Care Log: only the two named accounts may read or write anything.
// Replace MARK_EMAIL with Mark's sign-in email before publishing these rules
// in the Firebase console (Firestore Database > Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "markbrown667@gmail.com",
          "shelleybrown23@gmail.com"
        ];
    }

    // Read-only relatives or friends: medicines, med-log/vitals/trend entries and the
    // chemo/mood day records only. Never documents, cheers, food, notes, exercise or
    // who-to-call, and never write access. Add further emails to this list as needed.
    function isViewer() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "VIEWER_EMAIL"
        ];
    }

    // Each document page is kept well under the 1 MiB Firestore limit by the app;
    // this guard stops anything oversized being written by mistake.
    function pageSizeOk() {
      return request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }

    match /entries/{entryId} {
      allow read: if isFamily() || (isViewer() && resource.data.type in ['med', 'temp', 'vitals', 'weight', 'sleep', 'drink']);
      allow write: if isFamily();
    }

    match /medicines/{medId} {
      allow read: if isFamily() || isViewer();
      allow write: if isFamily();
    }

    match /documents/{docId} {
      allow read, write: if isFamily();

      match /pages/{pageNo} {
        allow read, delete: if isFamily();
        allow create, update: if isFamily() && pageSizeOk();
      }
    }

    match /profile/{profileId} {
      allow read, write: if isFamily();
    }

    // Chemo Party Plan: one document per calendar day (chemo session, done, mood, one good thing)
    match /days/{dayId} {
      allow read: if isFamily() || isViewer();
      allow write: if isFamily();
    }

    // Cheer board: short notes between the two of them
    match /cheers/{cheerId} {
      allow read, write: if isFamily();
    }

    // Exercise: one document per day (steps, which daily goals were done)
    match /exercise/{dayId} {
      allow read, write: if isFamily();
    }

    // Saved meals: quick buttons for logging food, with what goes with each one
    match /meals/{mealId} {
      allow read, write: if isFamily();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
