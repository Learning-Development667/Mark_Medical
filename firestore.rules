rules_version = '2';

// Daybook: one locked folder per household (since v75).
//
// Every household's data lives under households/{hid}/... and can be reached only by the
// accounts listed in households/{hid}/members/{uid} { name, role, relation }. The role is
// "family" (full read and write), "readonly" (sees everything a family member sees, writes
// nothing) or "viewer" (a narrow read-only slice: medicines, the treatment calendar and the
// trend readings). users/{uid} { household } tells a sign-in which household it belongs to.
// Members records and household records are never written by the app: the bridge (a service
// account, which bypasses these rules) and the Actions-tab workflows write them.
//
// No email address appears in this file, in config.js or anywhere on the site; the repository
// is public, so that matters. Publish with the "Publish database rules" workflow (Actions tab)
// or by pasting into Firestore Database > Rules; editing this file alone changes nothing live.
//
// tests/rules/ is the break-in suite (a stranger, another household, a read-only writer, a
// viewer reaching for food or letters, anyone writing a members record): every case must be
// refused. It runs on Google's Firestore emulator on every push that touches the rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---- Households ----
    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }
    function isMember(hid) { return signedIn() && exists(memberPath(hid)); }
    function role(hid) { return get(memberPath(hid)).data.role; }
    function hasRole(hid, roles) { return isMember(hid) && role(hid) in roles; }
    function isFamily(hid) { return hasRole(hid, ['family']); }
    function isViewer(hid) { return hasRole(hid, ['viewer']); }
    // family and readonly see everything; viewer sees only the slice named below
    function canRead(hid) { return hasRole(hid, ['family', 'readonly']); }

    // Each document page and recording part is kept well under the 1 MiB Firestore limit by the
    // app; this guard stops anything oversized being written by mistake.
    function pageSizeOk() {
      return request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }

    // A signed-in person can read their own pointer record and nothing else here.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Apple Health inbox keys, hashed, mapping to a household: the bridge's alone.
    match /healthKeys/{keyHash} {
      allow read, write: if false;
    }

    match /households/{hid} {
      // The household record itself (name, owner, created): members may read it.
      allow read: if isMember(hid);
      allow write: if false;

      // Who belongs: a member sees their own record; family sees everyone's. Nobody writes one.
      match /members/{uid} {
        allow read: if isMember(hid) && (request.auth.uid == uid || isFamily(hid));
        allow write: if false;
      }

      match /entries/{entryId} {
        allow read: if canRead(hid) || (isViewer(hid) && resource.data.type in ['med', 'temp', 'vitals', 'weight', 'sleep', 'drink']);
        allow write: if isFamily(hid);
      }

      match /medicines/{medId} {
        allow read: if canRead(hid) || isViewer(hid);
        allow write: if isFamily(hid);
      }

      match /documents/{docId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
        match /pages/{pageNo} {
          allow read: if canRead(hid);
          allow delete: if isFamily(hid);
          allow create, update: if isFamily(hid) && pageSizeOk();
        }
      }

      match /profile/{profileId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
      }

      // Treatment plan: one document per calendar day (session, done, mood, one good thing)
      match /days/{dayId} {
        allow read: if canRead(hid) || isViewer(hid);
        allow write: if isFamily(hid);
      }

      // Exercise: one document per day (steps, which programme items were done, workouts)
      match /exercise/{dayId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
      }

      // Saved meals
      match /meals/{mealId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
      }

      // Day totals from a food app, written by the bridge or by hand
      match /nutrition/{dayId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
      }

      // Recorded answers to questions for the team, stored as base64 chunks in parts
      match /recordings/{recId} {
        allow read: if canRead(hid);
        allow write: if isFamily(hid);
        match /parts/{partNo} {
          allow read: if canRead(hid);
          allow delete: if isFamily(hid);
          allow create, update: if isFamily(hid) && pageSizeOk();
        }
      }

      // Medicine reminders: one document per phone with reminders on, and one-off requests;
      // both read by the bridge's service account
      match /pushSubs/{subId} {
        allow read, write: if isFamily(hid);
      }
      match /reminders/{reminderId} {
        allow read, write: if isFamily(hid);
      }

      // The household's own secrets, written by the workflows: the Apple Health inbox key, so the
      // app can show it under Settings. Family may read it; nobody writes it from the app.
      match /private/{docId} {
        allow read: if isFamily(hid);
        allow write: if false;
      }

      // The bridge's own logs (last Apple Health send, reminder and explain counts): its alone
      match /bridge/{docId} {
        allow read, write: if false;
      }

      // Invite codes (item 8 on the roadmap): the bridge's alone
      match /invites/{code} {
        allow read, write: if false;
      }
    }

    // ---- TRANSITION: the pre-v75 shared layout ----
    // Kept only until the old top-level collections are cleaned up after the migration, so a
    // phone still running an older version keeps working. Remove this whole block (down to
    // END TRANSITION) in the clean-up commit.
    function oldAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function oldHasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && oldAccount().role in roles;
    }
    function oldFamily() { return oldHasRole(['family']); }
    function oldReadOnly() { return oldHasRole(['readonly']); }
    function oldViewer() { return oldHasRole(['viewer']); }

    match /entries/{entryId} {
      allow read: if oldFamily() || oldReadOnly() || (oldViewer() && resource.data.type in ['med', 'temp', 'vitals', 'weight', 'sleep', 'drink']);
      allow write: if oldFamily();
    }
    match /medicines/{medId} {
      allow read: if oldFamily() || oldReadOnly() || oldViewer();
      allow write: if oldFamily();
    }
    match /documents/{docId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
      match /pages/{pageNo} {
        allow read: if oldFamily() || oldReadOnly();
        allow delete: if oldFamily();
        allow create, update: if oldFamily() && pageSizeOk();
      }
    }
    match /profile/{profileId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
    }
    match /days/{dayId} {
      allow read: if oldFamily() || oldReadOnly() || oldViewer();
      allow write: if oldFamily();
    }
    match /exercise/{dayId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
    }
    match /meals/{mealId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
    }
    match /nutrition/{dayId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
    }
    match /recordings/{recId} {
      allow read: if oldFamily() || oldReadOnly();
      allow write: if oldFamily();
      match /parts/{partNo} {
        allow read: if oldFamily() || oldReadOnly();
        allow delete: if oldFamily();
        allow create, update: if oldFamily() && pageSizeOk();
      }
    }
    match /pushSubs/{subId} {
      allow read, write: if oldFamily();
    }
    match /reminders/{reminderId} {
      allow read, write: if oldFamily();
    }
    // ---- END TRANSITION ----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
