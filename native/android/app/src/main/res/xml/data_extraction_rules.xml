<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing Daybook keeps on the phone goes into Google's cloud backup or to a new phone by device transfer:
     a circle's records live in Firestore and come back when the person signs in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
